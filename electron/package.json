{
  "name": "cloud-chaser",
  "productName": "Cloud Chaser",
  "version": "1.1.1",
  "description": "Download your own tracks and recover instrumentals with Demucs.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npm run export --prefix ../frontend && electron .",
    "dist": "electron-builder --mac zip"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.github.dwwr.cloud-chaser",
    "productName": "Cloud Chaser",
    "asar": true,
    "afterPack": "after-pack.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.js",
      "setup.html",
      "splash.html",
      "houseplants.png",
      "icon.png"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "icon.png",
      "target": ["zip"],
      "identity": null,
      "gatekeeperAssess": false
    },
    "extraResources": [
      {
        "from": "vendor/python",
        "to": "python"
      },
      {
        "from": "../frontend/out",
        "to": "ui"
      },
      {
        "from": "../cli.py",
        "to": "app/cli.py"
      },
      {
        "from": "../server.py",
        "to": "app/server.py"
      },
      {
        "from": "../soundcloud_pull.py",
        "to": "app/soundcloud_pull.py"
      },
      {
        "from": "../make_instrumental.py",
        "to": "app/make_instrumental.py"
      },
      {
        "from": "../pyproject.toml",
        "to": "app/pyproject.toml"
      },
      {
        "from": "../README.md",
        "to": "app/README.md"
      }
    ]
  }
}
